@startuml
!include common-style.puml
left to right direction
title Диаграмма классов доменного контура назначения

package "Оркестратор" {
  class AssignmentService #E0F2FE {
    + processBranch()
    + processDoctor()
  }
}
package "Порты домена" {
  interface DoctorContextResolver {
    + resolve(event)
  }
  interface AvailableServicesResolver {
    + resolve(cache, doctor)
  }
  interface QueueVisitProvider {
    + findWaitingVisits(cache)
  }
  interface VisitRouteAnalyzer {
    + analyze(visit)
  }
  interface SelectionService {
    + select(...)
  }
  interface AssignmentExecutor {
    + assignAndTransfer(...)
  }
}
package "Реализации" {
  class DefaultMatcher #E0F2FE {
    + match(...)
  }
  class MedRobotAwareSelection #E0F2FE {
    - fallbackMode
    - robotGateway
    + select(...)
  }
  class DefaultExecutor #E0F2FE {
    + assignService()
    + transferVisit()
  }
}
package "Интеграция" {
  interface MedRobotGateway {
    + selectOptimal()
  }
}
package "Модели и кэш" {
  class BranchCache #DCFCE7 {
    + serviceById
    + queueByServiceId
  }
  class VisitDetails #DCFCE7 {
    + visitId
    + unservedServices
  }
  class SelectedService #DCFCE7 {
    + serviceId
    + queueId
  }
}

AssignmentService ..> DoctorContextResolver
AssignmentService ..> AvailableServicesResolver
AssignmentService ..> QueueVisitProvider
AssignmentService ..> VisitRouteAnalyzer
AssignmentService ..> SelectionService
AssignmentService ..> AssignmentExecutor
SelectionService <|.. MedRobotAwareSelection
VisitRouteAnalyzer <|.. DefaultMatcher
AssignmentExecutor <|.. DefaultExecutor
MedRobotAwareSelection ..> MedRobotGateway
MedRobotAwareSelection --> SelectedService
DefaultExecutor --> VisitDetails
AvailableServicesResolver ..> BranchCache
QueueVisitProvider ..> BranchCache
VisitRouteAnalyzer ..> VisitDetails

note bottom
Домен связан с REST только через порты и gateway-интерфейсы. Входной
моделью алгоритма служит локальный кэш отделения; med-robot остается
опциональным расширением выбора.
end note
@enduml
