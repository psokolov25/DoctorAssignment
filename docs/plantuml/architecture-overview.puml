@startuml
' Улучшенный вариант с акцентом на отказоустойчивость при потере связи с Orchestra.
left to right direction
skinparam backgroundColor #F8FAFC
skinparam defaultFontName Segoe UI
skinparam defaultFontSize 15
skinparam shadowing false
skinparam ArrowColor #334155
skinparam ArrowThickness 1.5
skinparam packageStyle rectangle
skinparam componentStyle rectangle
skinparam rectangleRoundCorner 12
skinparam linetype ortho
skinparam wrapWidth 220
skinparam maxMessageSize 120
skinparam nodesep 55
skinparam ranksep 55
skinparam component {
  BackgroundColor #E0F2FE
  BorderColor #0369A1
  FontColor #0F172A
}
skinparam package {
  BackgroundColor #FCFCFF
  BorderColor #7C3AED
  FontColor #111827
}
skinparam database {
  BackgroundColor #DCFCE7
  BorderColor #15803D
}
skinparam artifact {
  BackgroundColor #FFF7ED
  BorderColor #C2410C
}

title Общая архитектура Doctor Assistant и med-robot

rectangle "<<external system>>\nQMatic Orchestra 6\n--\nREST API справочников\nREST API рабочих действий\nSockJS / STOMP события" as orchestra #F3F4F6
rectangle "<<external service>>\nmed-robot\n--\nREST API выбора услуги\nи очереди" as medrobot #F3F4F6
artifact "Файловые журналы\n--\nmed-robot.log\nhttp.log" as logs

package "Doctor Assistant / service\nmed-doctor-assignment-service" {
  component "WebSocketService\n--\nприем событий" as websocket
  component "EventHandler\n--\nкорреляция сессии" as handler
  component "PollingJob\n--\nстрахующая сверка" as polling
  component "AssignmentService\n--\nдоменный цикл" as assignment
  component "SelectionService\n--\nвыбор услуги" as selection
  component "VisitWorkflowGateway\n--\nassign / transfer" as workflow
  component "OrchestraReconnectPolicy\n--\nне роняет процесс\nпланирует retry\ncache bootstrap / refresh" as retry #EEF2FF
  database "BranchCache\n--\nлокальный снимок\nсправочников" as cache
}

orchestra -[dashed]-> websocket : события
websocket --> handler : event
handler --> assignment : USER_SESSION_READY
polling --> assignment : POLLING
assignment --> cache : читает
assignment --> selection : выбор
selection -[dashed]-> medrobot : POST /optimalqueue
medrobot -[dashed]-> selection : решение
assignment --> workflow : мутации
workflow --> orchestra : REST Orchestra
workflow --> logs : диагностика
retry -[dashed]-> assignment : retry bootstrap / refresh
assignment --> retry : ошибки связи с Orchestra

note bottom of assignment
События и расписание запускают один доменный цикл.
При отсутствии или потере связи с Orchestra сервис не падает,
а остается запущенным и периодически повторяет попытку подключения.
end note
@enduml
