@startuml
title Наблюдаемость и эксплуатационная проверка

' Единый профиль диаграмм документации Doctor Assistant.
' Акцент: аккуратная business/UML-нотация, прозрачные подписи стрелок,
' ровная сетка, короткие технические подписи и читаемый шрифт без засечек.
skinparam backgroundColor #F8FAFC
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 13
skinparam defaultTextAlignment center
skinparam wrapWidth 170
skinparam maxMessageSize 120
skinparam linetype ortho
skinparam ArrowColor #334155
skinparam ArrowThickness 1.2
skinparam packageStyle rectangle
skinparam componentStyle uml2
skinparam classAttributeIconSize 0
skinparam handwritten false
skinparam RoundCorner 6
skinparam nodesep 38
skinparam ranksep 46
skinparam package {
  BackgroundColor #FFFFFF
  BorderColor #7C3AED
  FontColor #111827
}
skinparam component {
  BackgroundColor #E0F2FE
  BorderColor #0369A1
  FontColor #111827
}
skinparam interface {
  BackgroundColor #F8FAFC
  BorderColor #64748B
  FontColor #111827
}
skinparam database {
  BackgroundColor #DCFCE7
  BorderColor #15803D
  FontColor #111827
}
skinparam artifact {
  BackgroundColor #FEF3C7
  BorderColor #B45309
  FontColor #111827
}
skinparam node {
  BackgroundColor #FFFFFF
  BorderColor #64748B
  FontColor #111827
}
skinparam note {
  BackgroundColor #FEF3C7
  BorderColor #B45309
  FontColor #111827
}
skinparam actor {
  BorderColor #475569
  FontColor #111827
}
skinparam sequence {
  ArrowColor #334155
  ArrowThickness 1.2
  LifeLineBorderColor #CBD5E1
  LifeLineBackgroundColor transparent
  ParticipantBackgroundColor #E0F2FE
  ParticipantBorderColor #0369A1
  ParticipantFontColor #111827
  GroupBorderColor #94A3B8
  GroupBackgroundColor transparent
  GroupFontColor #334155
  BoxBackgroundColor transparent
  BoxBorderColor #CBD5E1
}
skinparam responseMessageBelowArrow true

left to right direction
component "Старт службы\nверсия, маркер" <<log point>> as start
component "Конфигурация\nбез секретов" <<log point>> as cfg
component "Пересборка кэша\nрезультат по branch" <<log point>> as cache
component "Источник запуска\nevent / polling" <<log point>> as source
component "Выбор услуги\nlocal / med-robot" <<log point>> as select
component "Мутации Orchestra\nassign / transfer" <<log point>> as mutation
component "Итог цикла\nprocessed / skipped" <<log point>> as result
artifact "Проверить в журнале\nbranchId\nservicePointId\nstaffId\ntriggerSource\nfallbackReason, targetQueueId" <<checklist>> as checklist
start ..> cfg
cfg ..> cache
cache ..> source
source ..> select
select ..> mutation
mutation ..> result
result ..> checklist : контекст
note bottom
  По одному циклу должно быть понятно: что запустило обработку,
  какой врач восстановлен, почему выбрана услуга,
  был ли fallback и какая очередь стала целевой.
end note
@enduml
