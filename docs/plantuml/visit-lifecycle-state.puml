@startuml
title Состояния визита при автоматическом назначении

' Единый профиль диаграмм документации Doctor Assistant.
' Акцент: аккуратная business/UML-нотация, прозрачные подписи стрелок,
' ровная сетка, короткие технические подписи и читаемый шрифт без засечек.
skinparam backgroundColor #F8FAFC
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 13
skinparam defaultTextAlignment center
skinparam wrapWidth 170
skinparam maxMessageSize 120
skinparam linetype ortho
skinparam ArrowColor #334155
skinparam ArrowThickness 1.2
skinparam packageStyle rectangle
skinparam componentStyle uml2
skinparam classAttributeIconSize 0
skinparam handwritten false
skinparam RoundCorner 6
skinparam nodesep 38
skinparam ranksep 46
skinparam package {
  BackgroundColor #FFFFFF
  BorderColor #7C3AED
  FontColor #111827
}
skinparam component {
  BackgroundColor #E0F2FE
  BorderColor #0369A1
  FontColor #111827
}
skinparam interface {
  BackgroundColor #F8FAFC
  BorderColor #64748B
  FontColor #111827
}
skinparam database {
  BackgroundColor #DCFCE7
  BorderColor #15803D
  FontColor #111827
}
skinparam artifact {
  BackgroundColor #FEF3C7
  BorderColor #B45309
  FontColor #111827
}
skinparam node {
  BackgroundColor #FFFFFF
  BorderColor #64748B
  FontColor #111827
}
skinparam note {
  BackgroundColor #FEF3C7
  BorderColor #B45309
  FontColor #111827
}
skinparam actor {
  BorderColor #475569
  FontColor #111827
}
skinparam sequence {
  ArrowColor #334155
  ArrowThickness 1.2
  LifeLineBorderColor #CBD5E1
  LifeLineBackgroundColor transparent
  ParticipantBackgroundColor #E0F2FE
  ParticipantBorderColor #0369A1
  ParticipantFontColor #111827
  GroupBorderColor #94A3B8
  GroupBackgroundColor transparent
  GroupFontColor #334155
  BoxBackgroundColor transparent
  BoxBorderColor #CBD5E1
}
skinparam responseMessageBelowArrow true

[*] --> Unknown : старт
state "Очередь\n«врач не назначен»" as Unknown
state "Анализ\nмаршрута" as Route
state "Выбор\nуслуги" as Select
state "Проверка\nmed-robot" as Robot
state "Локальный\nfallback" as Local
state "Назначение\nуслуги" as Assign
state "Перевод\nв очередь" as Transfer
Unknown --> Route : врач
Route --> Select : услуги
Select --> Robot : robot on
Select --> Local : robot off
Robot --> Assign : валидно
Robot --> Local : fallback
Local --> Assign : локально
Assign --> Transfer : assign готов
Transfer --> [*]
note bottom
  Диаграмма фиксирует business lifecycle: где принимается решение,
  где включается fallback и где выполняются REST-мутации.
end note
@enduml
