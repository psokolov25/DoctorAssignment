@startuml
title Последовательность назначения визита врачу

' Единый профиль диаграмм документации Doctor Assistant.
' Акцент: аккуратная business/UML-нотация, прозрачные подписи стрелок,
' ровная сетка, короткие технические подписи и читаемый шрифт без засечек.
skinparam backgroundColor #F8FAFC
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 13
skinparam defaultTextAlignment center
skinparam wrapWidth 170
skinparam maxMessageSize 120
skinparam linetype ortho
skinparam ArrowColor #334155
skinparam ArrowThickness 1.2
skinparam packageStyle rectangle
skinparam componentStyle uml2
skinparam classAttributeIconSize 0
skinparam handwritten false
skinparam RoundCorner 6
skinparam nodesep 38
skinparam ranksep 46
skinparam package {
  BackgroundColor #FFFFFF
  BorderColor #7C3AED
  FontColor #111827
}
skinparam component {
  BackgroundColor #E0F2FE
  BorderColor #0369A1
  FontColor #111827
}
skinparam interface {
  BackgroundColor #F8FAFC
  BorderColor #64748B
  FontColor #111827
}
skinparam database {
  BackgroundColor #DCFCE7
  BorderColor #15803D
  FontColor #111827
}
skinparam artifact {
  BackgroundColor #FEF3C7
  BorderColor #B45309
  FontColor #111827
}
skinparam node {
  BackgroundColor #FFFFFF
  BorderColor #64748B
  FontColor #111827
}
skinparam note {
  BackgroundColor #FEF3C7
  BorderColor #B45309
  FontColor #111827
}
skinparam actor {
  BorderColor #475569
  FontColor #111827
}
skinparam sequence {
  ArrowColor #334155
  ArrowThickness 1.2
  LifeLineBorderColor #CBD5E1
  LifeLineBackgroundColor transparent
  ParticipantBackgroundColor #E0F2FE
  ParticipantBorderColor #0369A1
  ParticipantFontColor #111827
  GroupBorderColor #94A3B8
  GroupBackgroundColor transparent
  GroupFontColor #334155
  BoxBackgroundColor transparent
  BoxBorderColor #CBD5E1
}
skinparam responseMessageBelowArrow true

hide footbox

actor "Orchestra" as O
participant "STOMP\nhandler" as S
participant "Event\nhandler" as H
participant "Assignment\ncycle" as A
participant "Branch\ncache" as C
participant "Selection" as M
participant "Visit\nworkflow" as W
participant "med-robot" as R
O -> S : событие посадки / профиля
S -> H : OrchestraEvent
H -> H : дедупликация и корреляция
H -> A : USER_SESSION_READY
A -> C : получить кэш
C --> A : справочники + runtime
A -> W : визиты unknown-doctor
W --> A : кандидаты
loop каждый визит
  A -> W : маршрут визита
  W --> A : непройденные услуги
  A -> M : выбрать услугу
  opt med-robot включен
    M -> R : POST /optimalqueue
    R --> M : serviceId + queueId
  end
  M --> A : решение / fallback
  A -> W : assign + transfer
end
note over A,W
  Заголовки lifeline сокращены, чтобы диаграмма читалась в PDF без наездов.
end note
@enduml
