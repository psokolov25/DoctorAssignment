@startuml
!include common-style.puml
left to right direction
title Диаграмма пакетов и направлений зависимостей

package "com.qsystems.meddoctorassignment\nкорневой пакет приложения" {
  package "Точка входа" {
    component "websocket\nSockJS / STOMP" as websocket
    component "event\nкорреляция" as event
    component "schedule\ncron-сверка" as schedule

    websocket -[hidden]down-> event
    event -[hidden]down-> schedule
  }

  package "Домен" {
    interface "domain.service" as service
    component "domain.impl\nалгоритмы" as impl
    class "domain.model\nмодели" as model
    database "cache\nлокальный срез" as cache
    class "util\nlock / TTL" as util

    service -[hidden]down-> impl
    impl -[hidden]right-> model
    impl -[hidden]down-> cache
    model -[hidden]down-> util
  }

  package "Адаптеры" {
    interface "gateway" as gateway
    component "gateway.impl\nреализация" as gatewayImpl
    component "orchestra\nREST" as orchestra
    component "medrobot\nREST" as medrobot

    gateway -[hidden]down-> gatewayImpl
    gatewayImpl -[hidden]down-> orchestra
    orchestra -[hidden]down-> medrobot
  }

  package "Платформа" {
    artifact "config\nyml / flags" as config
    component "diagnostics\nchecks" as diagnostics

    config -[hidden]down-> diagnostics
  }
}

websocket --> service : события
event --> service : запуск\nцикла
schedule ..> service : плановая\nсверка

service --> impl : контракты
impl --> model : модели
impl --> cache : локальный\nкэш
impl ..> gateway : порты

gateway --> gatewayImpl : реализация
gatewayImpl --> orchestra : Orchestra\nREST
gatewayImpl --> medrobot : med-robot\nREST

config ..> service : flags
config --> diagnostics : checks

note bottom
Стрелки показывают допустимое направление зависимостей: доменный слой
зависит от контрактов и портов, но не от конкретных REST-клиентов.
end note
@enduml
