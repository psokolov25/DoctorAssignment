@startuml
left to right direction
skinparam backgroundColor #F8FAFC
skinparam defaultFontName Segoe UI
skinparam defaultFontSize 15
skinparam shadowing false
skinparam ArrowColor #334155
skinparam ArrowThickness 1.4
skinparam packageStyle rectangle
skinparam componentStyle rectangle
skinparam rectangleRoundCorner 12
skinparam linetype ortho
skinparam wrapWidth 220
skinparam nodesep 50
skinparam ranksep 50
skinparam package {
  BackgroundColor #FCFCFF
  BorderColor #7C3AED
}
skinparam rectangle {
  BackgroundColor #FBF7FF
  BorderColor #7C3AED
}

title Диаграмма пакетов и направлений зависимостей

package "com.qsystems.meddoctorassignment\nкорневой пакет приложения" {
  package "Точка входа" {
    rectangle "websocket\nSockJS / STOMP" as websocket
    rectangle "event\nкорреляция" as event
    rectangle "schedule\ncron-сверка" as schedule
  }

  package "Домен" {
    rectangle "domain.service\nконтракты" as service
    rectangle "domain.impl\nалгоритмы" as impl
    rectangle "domain.model\nмодели" as model
    rectangle "cache\nлокальный срез" as cache
    rectangle "util\nlock / TTL" as util
  }

  package "Адаптеры" {
    rectangle "gateway\nпорты" as gateway
    rectangle "gateway.impl\nреализации" as gatewayImpl
    rectangle "orchestra\nREST" as orchestra
    rectangle "medrobot\nREST" as medrobot
  }

  package "Платформа" {
    rectangle "config\nyml / flags" as config
    rectangle "diagnostics\nchecks" as diagnostics
  }
}

websocket --> event : события
schedule -[dashed]-> service : страхующая сверка
event --> service : запуск
service --> impl : impl
impl --> cache : кэш / модели
impl -[dashed]-> gateway : порты
gateway --> gatewayImpl : реализация
gatewayImpl --> orchestra : REST
gatewayImpl --> medrobot : REST
config -[dashed]-> websocket : config
config -[dashed]-> schedule : config
config --> diagnostics : flags

note bottom
Стрелки показывают допустимое направление зависимостей:
доменный слой зависит только от контрактов и портов,
а не от конкретных REST-клиентов и платформенных реализаций.
end note
@enduml
