@startuml
title Диаграмма классов доменного контура назначения

skinparam backgroundColor #F8FAFC
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 14
skinparam defaultTextAlignment center
skinparam wrapWidth 260
skinparam ArrowColor #334155
skinparam ArrowThickness 1.3
skinparam class {
  BackgroundColor #E0F2FE
  BorderColor #0284C7
  FontColor #0F172A
}
skinparam interface {
  BackgroundColor #F1F5F9
  BorderColor #64748B
  FontColor #0F172A
}
skinparam note {
  BackgroundColor #FEF3C7
  BorderColor #F59E0B
}

class "Главный оркестратор\nAutonomousMedicalExamAssignmentService" as Assignment {
  +process(context)
}

interface "Восстановление контекста врача\nLoggedDoctorContextResolver" as ContextResolver
interface "Доступные услуги врача\nDoctorAvailableServicesResolver" as AvailableResolver
interface "Получение визитов из очереди\nUnknownDoctorQueueVisitProvider" as VisitProvider
interface "Анализ маршрута визита\nVisitRouteAnalyzer" as RouteAnalyzer
interface "Выбор услуги и очереди\nDoctorServiceSelectionService" as SelectionService
interface "Выполнение мутаций визита\nVisitAssignmentExecutor" as AssignmentExecutor

class "Локальный + robot выбор\nMedRobotAwareDoctorServiceSelectionService" as RobotSelection {
  +select(visit, services, cache)
}
class "Локальный подбор услуги\nDefaultDoctorServiceMatcher" as LocalMatcher
class "REST-шлюз med-robot\nMedRobotOptimalServiceGatewayImpl" as RobotGateway
class "Кэш отделения\nBranchAssignmentCache" as BranchCache
class "Выбранная услуга\nSelectedDoctorService" as Selected
class "Детали визита\nVisitDetails" as VisitDetails
class "Непройденная услуга\nVisitUnservedService" as Unserved

Assignment --> ContextResolver : восстанавливает врача
Assignment --> AvailableResolver : получает услуги врача
Assignment --> VisitProvider : читает очередь «врач не назначен»
Assignment --> RouteAnalyzer : строит маршрут визита
Assignment --> SelectionService : выбирает услугу и очередь
Assignment --> AssignmentExecutor : назначает и переводит визит
Assignment --> BranchCache : читает справочники

SelectionService <|.. RobotSelection
RobotSelection --> LocalMatcher : предварительный локальный выбор
RobotSelection --> RobotGateway : опциональный REST-вызов
RobotSelection --> Selected : возвращает результат
RouteAnalyzer --> VisitDetails : формирует модель
VisitDetails o-- Unserved : содержит маршрут

note right of RobotSelection
  Внешний med-robot не заменяет локальную схему.
  Он уточняет результат только при включенном флаге
  `application.med-robot.enabled`.
end note
@enduml
