@startuml
left to right direction
skinparam backgroundColor #F8FAFC
skinparam defaultFontName Segoe UI
skinparam defaultFontSize 15
skinparam shadowing false
skinparam ArrowColor #334155
skinparam ArrowThickness 1.4
skinparam classAttributeIconSize 0
skinparam linetype ortho
skinparam wrapWidth 220
skinparam nodesep 50
skinparam ranksep 55
skinparam packageStyle rectangle
skinparam rectangleRoundCorner 12
skinparam class {
  BackgroundColor #FFFFFF
  BorderColor #64748B
}
skinparam interface {
  BackgroundColor #FFFFFF
  BorderColor #64748B
}

title Диаграмма классов доменного контура назначения

package "Оркестратор" {
  class AssignmentService #E0F2FE {
    + processBranch()
    + processDoctor()
  }
}

package "Порты домена" {
  interface DoctorContextResolver {
    + resolve(event)
  }
  interface AvailableServicesResolver {
    + resolve(cache, doctor)
  }
  interface QueueVisitProvider {
    + findWaitingVisits(cache)
  }
  interface VisitRouteAnalyzer {
    + analyze(visit)
  }
  interface SelectionService {
    + select(...)
  }
  interface AssignmentExecutor {
    + assignAndTransfer(...)
  }
}

package "Реализации" {
  class DefaultMatcher #E0F2FE {
    + match(...)
  }
  class MedRobotAwareSelection #E0F2FE {
    - fallbackMode
    - robotGateway
    + select(...)
  }
  class DefaultExecutor #E0F2FE {
    + assignService()
    + transferVisit()
  }
}

package "Интеграция" {
  interface MedRobotGateway {
    + selectOptimal()
  }
}

package "Модели и кэш" {
  class BranchCache #DCFCE7 {
    + serviceById
    + queueByServiceId
  }
  class VisitDetails #DCFCE7 {
    + visitId
    + unservedServices
  }
  class SelectedService #DCFCE7 {
    + serviceId
    + queueId
  }
}

AssignmentService ..> DoctorContextResolver : использует
AssignmentService ..> AvailableServicesResolver : использует
AssignmentService ..> QueueVisitProvider : использует
AssignmentService ..> VisitRouteAnalyzer : использует
AssignmentService ..> SelectionService : использует
AssignmentService ..> AssignmentExecutor : использует

SelectionService <|.. MedRobotAwareSelection
VisitRouteAnalyzer <|.. DefaultMatcher
AssignmentExecutor <|.. DefaultExecutor

MedRobotAwareSelection ..> MedRobotGateway : вызывает
MedRobotAwareSelection --> SelectedService : возвращает
DefaultExecutor --> VisitDetails : использует
AvailableServicesResolver ..> BranchCache : читает
QueueVisitProvider ..> BranchCache : читает
VisitRouteAnalyzer ..> VisitDetails : анализирует

note bottom
Домен связан с REST только через порты и gateway-интерфейсы.
Входной моделью алгоритма служит локальный кэш отделения,
а выбор через med-robot остается опциональным расширением.
end note
@enduml
