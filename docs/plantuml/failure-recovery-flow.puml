@startuml
!include common-style.puml
title Отказы и восстановление без остановки цикла

start
:Триггер\nсобытие или cron;
:BranchLockManager\nзанять branch;
if (Кэш доступен?) then (да)
  :Выбрать визит\nиз unknown-doctor queue;
  if (REST-мутация успешна?) then (да)
    :Processed\nследующий визит;
  else (нет)
    if (403 / userState?) then (да)
      :Завершить branch\nбез серии повторов;
    else (нет)
      :Fallback\nили следующий визит;
    endif
  endif
else (нет)
  :Пропустить запуск\nwarning в лог;
endif
stop
@enduml
