@startuml
title Подробная последовательность выбора через med-robot

skinparam backgroundColor #F8FAFC
skinparam shadowing false
skinparam responseMessageBelowArrow true
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 14
skinparam defaultTextAlignment center
skinparam wrapWidth 260
skinparam maxMessageSize 230
skinparam sequence {
  ArrowColor #334155
  ArrowThickness 1.3
  LifeLineBorderColor #94A3B8
  LifeLineBackgroundColor #E2E8F0
  ParticipantBackgroundColor #E0F2FE
  ParticipantBorderColor #0284C7
  ParticipantFontColor #0F172A
  ActorBackgroundColor #FFFFFF
  ActorBorderColor #475569
}
skinparam NoteBackgroundColor #FEF3C7
skinparam NoteBorderColor #F59E0B
skinparam BoxBackgroundColor #FFFFFF
skinparam BoxBorderColor #CBD5E1

autonumber
participant "Цикл назначения\n`AutonomousMedicalExamAssignmentService`" as Cycle
participant "Анализ маршрута визита\n`VisitRouteAnalyzer`" as Route
participant "Локальный подбор\n`DoctorServiceMatcher`" as Local
participant "Выбор с учетом робота\n`MedRobotAwareDoctorServiceSelectionService`" as Selector
participant "Шлюз med-robot\n`MedRobotOptimalServiceGateway`" as Gateway
participant "REST API med-robot" as Robot
participant "Кэш отделения\n`BranchAssignmentCache`" as Cache

Cycle -> Route : получить непройденные услуги визита
Route --> Cycle : `VisitDetails` с маршрутом
Cycle -> Selector : выбрать итоговые `serviceId` и `queueId`
Selector -> Local : локальный предварительный выбор
Local -> Cache : проверить доступные услуги и очереди
Cache --> Local : допустимая локальная пара
Local --> Selector : локальный кандидат

alt `application.med-robot.enabled=false`
  Selector --> Cycle : вернуть локальную пару без REST-вызова
else med-robot включен
  Selector -> Selector : собрать отсортированный список непройденных `serviceId`
  Selector -> Gateway : branchId, currentServiceId, unservedServiceIds
  Gateway -> Robot : `POST /prorobot/optimalqueue/{branchId}/service/{serviceId}`
  Robot --> Gateway : `{ serviceId, queueId }`
  Gateway --> Selector : ответ med-robot
  Selector -> Cache : проверить известность очереди
  Selector -> Selector : проверить маршрут визита и строгие флаги
  alt ответ допустим
    Selector --> Cycle : вернуть выбор med-robot
  else ответ пустой, ошибочный или недопустимый
    Selector -> Selector : применить правила возврата к локальному алгоритму
    Selector --> Cycle : локальная пара или пустой результат
  end
end

note over Selector,Robot
  Диаграмма показывает только выбор услуги и очереди.
  Назначение услуги и перевод визита выполняются отдельным executor-ом.
end note
@enduml
